# Auth (Better Auth)
# Admin account seeded once with `npm run seed:admin`
ADMIN_EMAIL=info@example.com
ADMIN_PASSWORD=change-me
# >= 32 random chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=generate-a-strong-random-secret
# Canonical site URL (no trailing slash). Production: https://www.bakerization.com
BETTER_AUTH_URL=http://localhost:3000

# Database / Storage
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Contact mail (Resend)
RESEND_API_KEY=re_xxx
EMAIL_ADDRESS=info@example.com
CONTACT_TO=info@example.com
CONTACT_FROM=info@example.com

# Contact auto-reply
CONTACT_SEND_CONFIRMATION=true
CONTACT_CONFIRM_SUBJECT=
CONTACT_CONFIRM_TEXT=
CONTACT_CONFIRM_HTML=

# Ikeda AI, blog translations and homepage partnership generator (server only).
# Use the API organization receiving the ChatGPT Pro/Business API credit benefit.
OPENAI_API_KEY=
# Optional explicit routing to that same organization/project.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
